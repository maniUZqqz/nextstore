# =============================================================================
# پیکربندی فرانت‌اند
# =============================================================================
# این فایل را به `.env.local` کپی کنید و مقادیر را متناسب با محیط خودتان
# عوض کنید. `.env.local` در گیت نیست.

# آدرس API بک‌اند لاراول.
#
# ⚠️ پورت‌های ۸۰۰۰ و ۳۰۰۰ روی ماشین توسعه‌ی این پروژه اشغال بودند، پس
#    ۸۱۰۰ و ۳۱۰۰ انتخاب شدند. `run.bat` این مقدار را با پورت جاری
#    همگام می‌کند — دستی عوضش نکنید مگر اینکه سرور را هم دستی اجرا کنید.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100/api/v1

# آدرس عمومی سایت.
#
# در سه جا استفاده می‌شود: canonical و hreflang، نقشه‌ی سایت و
# robots.txt، و نشانی مطلق تصویر پیش‌نمایش شبکه‌های اجتماعی.
#
# ⚠️ در تولید حتماً دامنه‌ی واقعی با https باشد. اگر اشتباه بماند،
#    گوگل نشانی‌های محلی را ایندکس می‌کند و کارت اشتراک‌گذاری تصویر
#    نشان نمی‌دهد — هیچ‌کدام خطایی نمی‌دهند.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# راز مشترک برای باطل کردن کش از سمت لاراول.
#
# ⚠️ باید **دقیقاً** با `REVALIDATE_SECRET` در `nextstore-api/.env` یکی
#    باشد. اگر نخوانند، مسیر `/api/revalidate` هر درخواست را رد می‌کند و
#    ویرایش‌های پنل تا انقضای طبیعی کش (تا یک ساعت) در فروشگاه دیده
#    نمی‌شوند — بدون هیچ خطایی.
#
# ⚠️ عمداً بدون پیشوند NEXT_PUBLIC_ تا به باندل مرورگر نشت نکند.
REVALIDATE_SECRET=dev-only-revalidate-secret-change-me
