# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ⚠️ نمونه باید در مخزن بماند.
#
#    الگوی `.env*` قالب نکست، خودِ `.env.example` را هم می‌گیرد.
#    نتیجه‌اش این بود که هر کسی مخزن را کلون می‌کرد هیچ فهرستی از
#    متغیرهای لازم نداشت — و `REVALIDATE_SECRET` که پیشوند
#    NEXT_PUBLIC_ ندارد، در هیچ کد کلاینتی هم دیده نمی‌شود تا
#    بشود حدسش زد.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# اسکرین‌شات‌های بازبینی چشمی
.shots/
