# =============================================================================
# پیکربندی تحلیل ایستا — PHPStan با افزونه‌ی Larastan
# =============================================================================
# چه چیزی می‌گیرد که تست نمی‌گیرد؟ خطاهایی که فقط در مسیرِ اجرانشده
# ظاهر می‌شوند: متدی که روی مقدار null صدا زده می‌شود، آرگومان با نوع
# اشتباه، ویژگی‌ای که وجود ندارد. تست فقط مسیرهایی را می‌بیند که
# نوشته شده‌اند؛ این ابزار همه را می‌بیند.
#
# ⚠️ Larestan لازم است نه PHPStan خالی: بدون آن، هر `Model::query()`
#    و هر فاساد لاراول به‌عنوان خطا گزارش می‌شود چون تعریفشان در زمان
#    اجرا ساخته می‌شود.

includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # ⚠️ تحلیل موازی خاموش است.
    #
    #    هر worker حافظه‌ی خودش را می‌گیرد و روی این ماشین مجموعشان
    #    از سقف رد می‌شد. تک‌فرایندی کندتر است ولی تمام می‌شود.
    parallel:
        maximumNumberOfProcesses: 1

    paths:
        - app
        - database
        - routes
        - config

    # ⚠️ سطح ۵ نقطه‌ی شروع است، نه مقصد.
    #
    #    سطح ۹ روی پروژه‌ای که از ابتدا بدون تحلیل ایستا نوشته شده
    #    صدها خطا می‌دهد و نتیجه‌ی عملی‌اش این است که کسی هرگز اجرایش
    #    نمی‌کند. سطح ۵ خطاهای واقعی را می‌گیرد و پاس‌شدنی است؛
    #    بالا بردنش یک پله در هر بار، کار درست است.
    level: 5

    # ⚠️ پوشه‌ی تست عمداً بیرون است.
    #
    #    Pest با توابع سراسری (`it`, `expect`, `$this` در closure) کار
    #    می‌کند و PHPStan بدون افزونه‌ی مخصوصش آن‌ها را نمی‌فهمد.
    #    گزارش‌های کاذبِ فراوان، سیگنال واقعی را دفن می‌کنند.
    excludePaths:
        - tests

    # ⚠️ مسیر مهاجرت‌ها را باید صریح داد.
    #
    #    بدون آن، Larastan نوع ستون‌ها را نمی‌شناسد و هر ویژگی مدل را
    #    از روی حدس تایپ می‌کند؛ نتیجه‌اش صدها گزارش «ویژگی وجود ندارد»
    #    بود که هیچ‌کدام باگ نبودند و سیگنال واقعی را دفن می‌کردند.
    databaseMigrationsPath:
        - database/migrations

    # ⚠️ این پرچم پیش‌فرض **خاموش** است و باید روشن شود.
    #
    #    از لاراول ۱۱ به بعد، کست‌ها در متد `casts()` تعریف می‌شوند نه
    #    در ویژگی `$casts`. ولی Larastan فقط با این پرچم بدنه‌ی آن متد
    #    را می‌خواند؛ بدون آن، امضای `: array` را می‌بیند و هیچ کستی
    #    اعمال نمی‌کند.
    #
    #    نتیجه‌ی عملی‌اش این بود: `expires_at` به‌جای Carbon رشته
    #    تایپ می‌شد، `type` به‌جای enum رشته، و هر `?->toIso8601String()`
    #    خطا می‌گرفت. صدها گزارش که هیچ‌کدام باگ نبودند و سیگنال واقعی
    #    را دفن می‌کردند.
    parseModelCastsMethod: true

    # =========================================================================
    # دو قاعده‌ای که عمداً خاموش‌اند
    # =========================================================================
    # ⚠️ این‌ها «سرکوب خطا» نیستند؛ دو قاعده‌اند که پیروی از توصیه‌شان
    #    کد را **کم‌ایمن‌تر** می‌کند. هر مورد یک‌به‌یک بررسی شد.
    ignoreErrors:
        # ---------------------------------------------------------------------
        # ۱. «بررسی تهی‌بودن لازم نیست»
        # ---------------------------------------------------------------------
        # دو دسته مورد را می‌گیرد و هر دو دسته اشتباه‌اند:
        #
        #   الف) `$x?->prop ?? $default` — از نظر PHP واقعاً زائد است، چون
        #        `??` هشدارِ دسترسی به ویژگی روی null را خفه می‌کند. ولی
        #        `?->` قصد را صریح می‌گوید؛ برداشتنش یعنی کد به رفتار
        #        خفه‌کردنِ هشدار تکیه کند — چیزی که خواننده باید بداند و
        #        نمی‌داند.
        #
        #   ب) `$this->command?->info()` در سیدرها و
        #      `$user->currentAccessToken()?->id` — اینجا PHPStan
        #      **اشتباه** می‌کند. `Seeder::$command` در لاراول بدون مقدار
        #      اولیه اعلام شده (خودِ فریم‌ورک با `isset` محافظتش می‌کند) و
        #      `currentAccessToken()` وقتی احراز هویت با نشست باشد null
        #      برمی‌گرداند. برداشتن `?->` یعنی خطای مرگبار در همان
        #      مسیرهایی که این محافظ برایشان گذاشته شده.
        -
            identifier: nullsafe.neverNull

        # ---------------------------------------------------------------------
        # ۲. «`?? []` روی ویژگی‌ای که تهی نمی‌شود»
        # ---------------------------------------------------------------------
        # فقط یک جا رخ می‌دهد: `HasTranslations::translatableFields()`.
        #
        # تحلیل ایستا هر هشت مدلِ *فعلی* را می‌بیند که `$translatable` را
        # تعریف کرده‌اند. ولی تِرِیت قراردادش را با مدل‌های آینده هم
        # می‌بندد و مدلی که چیزی اعلام نکند بدون آن `?? []` خطا می‌دهد.
        #
        # ⚠️ اعلام ویژگی در خود تِرِیت آزموده شد و PHP ردش می‌کند: مدلی که
        #    همان ویژگی را با مقدار متفاوت تعریف کند خطای مرگبار
        #    «definition differs» می‌دهد و برنامه اصلاً بالا نمی‌آید.
        -
            identifier: nullCoalesce.property
