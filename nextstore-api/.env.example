APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ⚠️ فروشگاه فارسی‌محور است: زبان پیش‌فرض و بازگشتی هر دو fa.
#    نسخه‌ی خام لاراول اینجا en داشت و هر نصب تازه، پیام‌های
#    خطای انگلیسی به کاربر فارسی نشان می‌داد.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# متغیرهای اختصاصی این پروژه
# =============================================================================
# ⚠️ این بخش در نسخه‌ی خام لاراول نیست و بدون آن، دو قابلیت بی‌صدا
#    خاموش می‌مانند — نه خطایی می‌دهند و نه نشانه‌ای.

# نشانی فرانت‌اند نکست.
#
# دو کار به آن وابسته است:
#   ۱. پیوند داخل ایمیل بازیابی رمز. بدون این مقدار، پیوند نسبی ساخته
#      می‌شود و کاربر به هیچ‌جا نمی‌رسد.
#   ۲. باطل کردن کش نکست پس از تغییر کاتالوگ، تنظیمات یا بنرها.
FRONTEND_URL=http://127.0.0.1:3100

# راز مشترک با مسیر /api/revalidate فرانت‌اند.
#
# ⚠️ اگر تنظیم نشود، باطل‌کردن کش کاملاً خاموش می‌ماند: ادمین محصولی را
#    ویرایش می‌کند، لاراول درست جواب می‌دهد، دیتابیس درست است — ولی
#    فروشگاه تا انقضای طبیعی کش (تا یک ساعت) داده‌ی قدیمی نشان می‌دهد.
#
# ⚠️ عمداً بدون پیشوند NEXT_PUBLIC_ در سمت فرانت خوانده می‌شود تا هرگز
#    به باندل مرورگر نشت نکند. هر رشته‌ی تصادفی بلند مناسب است.
REVALIDATE_SECRET=

# دامنه‌هایی که اجازه‌ی فراخوانی API را دارند — با ویرگول جدا.
#
# ⚠️ در محیط local هر پورتی روی localhost خودکار مجاز است (config/cors.php)،
#    پس این فهرست فقط برای تولید معنا دارد.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
