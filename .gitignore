# =============================================================================
# .gitignore ریشه‌ی مخزن
# =============================================================================
# ⚠️ هر زیرپروژه `.gitignore` خودش را هم دارد. این فایل فقط چیزهایی را
#    کنار می‌گذارد که به سطح ریشه تعلق دارند یا هر دو زیرپروژه را
#    درگیر می‌کنند.

# --- ابزار پرتابل ---
# PHP و Composer پرتابل روی این سیستم نصب‌اند تا نیازی به نصب سراسری
# نباشد. حدود ۱۰۰ مگابایت باینری است و هرگز نباید وارد مخزن شود؛
# هر توسعه‌دهنده‌ی دیگری PHP خودش را دارد.
/tools/

# --- لاگ اجرای محلی ---
# run.bat خروجی هر دو سرور را اینجا می‌ریزد.
/.logs/

# --- دیتابیس ---
# ⚠️ SQLite است و فایل واقعی دیتابیس نباید commit شود: با هر اجرای
#    تست یا سفارش نمایشی عوض می‌شود و هر pull یک تعارض باینری می‌سازد.
#    ساختار در مهاجرت‌ها و داده‌ی نمونه در سیدرها است:
#        php artisan migrate:fresh --seed
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# --- سیستم‌عامل و ویرایشگر ---
Thumbs.db
.DS_Store
desktop.ini
/.idea/
/.vscode/
