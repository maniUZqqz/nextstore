# =============================================================================
# نرمال‌سازی خط‌پایان
# =============================================================================
# ⚠️ بدون این فایل، گیت روی ویندوز هنگام checkout خط‌پایان‌ها را به CRLF
#    تبدیل می‌کند و روی لینوکس/مک به LF می‌ماند. نتیجه: diff هایی که
#    کل فایل را «تغییریافته» نشان می‌دهند بدون آنکه چیزی عوض شده باشد.
#
#    `text=auto eol=lf` یعنی در مخزن همیشه LF ذخیره شود.

* text=auto eol=lf

# --- فایل‌های باینری ---
# اینها هرگز نباید نرمال‌سازی شوند؛ تبدیل خط‌پایان خرابشان می‌کند.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.sqlite  binary
*.pdf     binary

# --- اسکریپت‌های ویندوز ---
# ⚠️ cmd.exe به CRLF نیاز دارد. فایل .bat با LF روی ویندوز خطای
#    عجیب می‌دهد که ربطش به خط‌پایان اصلاً پیدا نیست.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# --- اسکریپت‌های شل ---
# هوک‌های گیت باید LF باشند حتی روی ویندوز، وگرنه Git Bash
# آن‌ها را اجرا نمی‌کند.
*.sh      text eol=lf
.githooks/* text eol=lf
